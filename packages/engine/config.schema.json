{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sleeves": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "universe": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            }
          },
          "lookbacks": {
            "default": [
              12
            ],
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "lookbackMode": {
            "default": "blend",
            "type": "string",
            "enum": [
              "blend",
              "average"
            ]
          },
          "momentum": {
            "default": "total",
            "type": "string",
            "enum": [
              "total",
              "skip1"
            ]
          },
          "topN": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "absFilter": {
            "default": "tbill",
            "type": "string",
            "enum": [
              "tbill",
              "zero",
              "off"
            ]
          },
          "safeHaven": {
            "default": {
              "mode": "fixed",
              "asset": "AGG"
            },
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "fixed"
                  },
                  "asset": {
                    "type": "string",
                    "pattern": "^[A-Z0-9_]+$"
                  }
                },
                "required": [
                  "mode",
                  "asset"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "bestOf"
                  },
                  "assets": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z0-9_]+$"
                    }
                  }
                },
                "required": [
                  "mode",
                  "assets"
                ],
                "additionalProperties": false
              }
            ]
          },
          "weighting": {
            "default": "equal",
            "type": "string",
            "enum": [
              "equal",
              "invVol"
            ]
          },
          "buffer": {
            "default": 0,
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "weight",
          "universe"
        ],
        "additionalProperties": false
      }
    },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "settings": {
      "default": {},
      "type": "object",
      "properties": {
        "rebalance": {
          "default": "monthly",
          "type": "string",
          "enum": [
            "monthly",
            "quarterly"
          ]
        },
        "executionLag": {
          "default": 0,
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            }
          ]
        },
        "currency": {
          "default": "USD",
          "type": "string",
          "enum": [
            "USD",
            "PLN",
            "EUR"
          ]
        },
        "costPct": {
          "default": 0.001,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fxCostPct": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tax": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "rate": {
              "default": 0.19,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "sleeves"
  ],
  "additionalProperties": false
}
